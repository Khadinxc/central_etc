let DetectionWindow = 30m;
let TrainingWindow = 14d;
let MinRequests = 20;
let MinDistinctUris = 10;
let MinDistinctUriDeviation = 3.0;
let MinBreadthDeviation = 1.5;
let StaticResourceRegex = @"(?i)(\.(js|css|map|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)(\?|$)|[?&]_rsc=)";
let StatusCodeFilters = dynamic([
    403,
    429
]);
let WhitelistedIps = dynamic([
    "192.0.2.10",
    "198.51.100.20"
]);
let WhitelistedRoutingRules = dynamic([
    "HealthCheckRoute",
    "KnownAutomationRoute"
]);
let FrontDoorData = materialize(
    AzureDiagnostics
    | where TimeGenerated >= ago(TrainingWindow)
    | where Category == "FrontDoorAccessLog"
    | where isnotempty(clientIp_s)
        and isnotempty(requestUri_s)
        and isnotempty(routingRuleName_s)
    | where clientIp_s !in (WhitelistedIps)
    | where routingRuleName_s !in (WhitelistedRoutingRules)
    | where not(toint(httpStatusCode_d) in (StatusCodeFilters))
    | where not(requestUri_s matches regex StaticResourceRegex)
    | extend
        clientCountry = tostring(AdditionalFields["clientCountry"]),
        responseBytes = tolong(AdditionalFields["responseBytes"])
    | extend
        NormalizedRequestUri = iff(
            requestUri_s contains "/_next/data/",
            replace_regex(
                requestUri_s,
                @"/_next/data/[^/]+/",
                "/_next/data/"
            ),
            requestUri_s
        )
    | project
        TimeGenerated,
        clientIp_s,
        routingRuleName_s,
        requestUri_s,
        NormalizedRequestUri,
        httpStatusCode_d,
        clientCountry,
        responseBytes
);
let HistoricalWindows =
    FrontDoorData
    | where TimeGenerated < ago(DetectionWindow)
    | summarize
        Requests = count(),
        DistinctUris = dcount(NormalizedRequestUri)
        by
            clientIp_s,
            routingRuleName_s,
            TimeBin = bin(TimeGenerated, DetectionWindow)
    | extend
        UriBreadthRatio =
            todouble(DistinctUris) / todouble(Requests);
let IpBaseline =
    HistoricalWindows
    | summarize
        MedianDistinctUris = percentile(DistinctUris, 50),
        P95DistinctUris = percentile(DistinctUris, 95),
        MedianBreadthRatio = percentile(UriBreadthRatio, 50),
        TrainingWindows = count()
        by
            clientIp_s,
            routingRuleName_s;
let RoutingRuleBaseline =
    HistoricalWindows
    | summarize
        RouteMedianDistinctUris = percentile(DistinctUris, 50),
        RouteP95DistinctUris = percentile(DistinctUris, 95),
        RouteMedianBreadthRatio = percentile(UriBreadthRatio, 50)
        by routingRuleName_s;
let CurrentStatusCodes =
    FrontDoorData
    | where TimeGenerated >= ago(DetectionWindow)
    | where isnotempty(httpStatusCode_d)
    | summarize
        StatusCount = count()
        by
            clientIp_s,
            routingRuleName_s,
            httpStatusCode_d
    | extend StatusCodeKey = tostring(toint(httpStatusCode_d))
    | summarize
        StatusCodes = make_bag(
            bag_pack(StatusCodeKey, StatusCount)
        )
        by
            clientIp_s,
            routingRuleName_s;
let CurrentActivity =
    FrontDoorData
    | where TimeGenerated >= ago(DetectionWindow)
    | summarize
        Requests = count(),
        DistinctUris = dcount(NormalizedRequestUri),
        ClientCountries = make_set(clientCountry, 10),
        MinResponseBytes = min(responseBytes),
        MaxResponseBytes = max(responseBytes),
        AvgResponseBytes = avg(responseBytes),
        MedianResponseBytes = percentile(responseBytes, 50),
        DistinctResponseSizes = dcount(responseBytes),
        SampleUris = make_set(requestUri_s, 20),
        FirstSeen = min(TimeGenerated),
        LastSeen = max(TimeGenerated)
        by
            clientIp_s,
            routingRuleName_s
    | extend
        UriBreadthRatio =
            todouble(DistinctUris) / todouble(Requests),
        ResponseSizeDiversity =
            todouble(DistinctResponseSizes) / todouble(Requests);
CurrentActivity
| join kind=leftouter CurrentStatusCodes
    on clientIp_s, routingRuleName_s
| join kind=leftouter IpBaseline
    on clientIp_s, routingRuleName_s
| join kind=leftouter RoutingRuleBaseline
    on routingRuleName_s
| extend
    IsNewClient = isempty(MedianDistinctUris),
    ExpectedDistinctUris = coalesce(
        MedianDistinctUris,
        RouteMedianDistinctUris
    ),
    ExpectedBreadthRatio = coalesce(
        MedianBreadthRatio,
        RouteMedianBreadthRatio
    ),
    BaselineType = iff(
        isempty(MedianDistinctUris),
        "RoutingRulePeer",
        "ClientHistorical"
    )
| extend
    DistinctUriDeviation =
        todouble(DistinctUris)
        / iif(
            ExpectedDistinctUris < 1,
            1.0,
            todouble(ExpectedDistinctUris)
        ),
    BreadthDeviation =
        UriBreadthRatio
        / iif(
            ExpectedBreadthRatio <= 0,
            0.01,
            ExpectedBreadthRatio
        )
| where Requests >= MinRequests
| where DistinctUris >= MinDistinctUris
| where DistinctUriDeviation >= MinDistinctUriDeviation
| where BreadthDeviation >= MinBreadthDeviation
| project
    clientIp_s,
    ClientCountries,
    routingRuleName_s,
    BaselineType,
    IsNewClient,
    Requests,
    DistinctUris,
    StatusCodes,
    MinResponseBytes,
    MaxResponseBytes,
    AvgResponseBytes,
    MedianResponseBytes,
    DistinctResponseSizes,
    ResponseSizeDiversity,
    UriBreadthRatio,
    ExpectedDistinctUris,
    DistinctUriDeviation,
    ExpectedBreadthRatio,
    BreadthDeviation,
    MedianDistinctUris,
    P95DistinctUris,
    RouteMedianDistinctUris,
    RouteP95DistinctUris,
    TrainingWindows,
    FirstSeen,
    LastSeen,
    SampleUris
| order by DistinctUriDeviation desc