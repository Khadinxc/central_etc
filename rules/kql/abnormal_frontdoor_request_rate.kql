let DetectionWindow = 30m;
let TrainingWindow = 14d;
let MinRequests = 20;
let MinDistinctUris = 10;
let MinDistinctUriDeviation = 3.0;
let MinBreadthDeviation = 1.5;
let MinStructureDeviation = 2.0;
let StaticResourceRegex = @"(?i)(\.(js|css|map|ico|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)(\?|$)|[?&]_rsc=)";
let StatusCodeFilters = dynamic([
    403.0,
    429.0
]);
let WhitelistedIps = dynamic([
    "192.0.2.10",
    "198.51.100.20"
]);
let WhitelistedRoutingRules = dynamic([
    "HealthCheckRoute",
    "KnownAutomationRoute"
]);
let CurrentRaw = materialize(
    AzureDiagnostics
    | where TimeGenerated >= ago(DetectionWindow)
    | where Category == "FrontDoorAccessLog"
    | where isnotempty(clientIp_s)
        and isnotempty(requestUri_s)
        and isnotempty(routingRuleName_s)
    | where clientIp_s !in (WhitelistedIps)
    | where routingRuleName_s !in (WhitelistedRoutingRules)
    | where httpStatusCode_d !in (StatusCodeFilters)
    | where not(requestUri_s matches regex StaticResourceRegex)
    | project
        TimeGenerated,
        clientIp_s,
        routingRuleName_s,
        requestUri_s,
        httpStatusCode_d,
        AdditionalFields
);
let CandidateClients = materialize(
    CurrentRaw
    | summarize hint.strategy=shuffle
        PreFilterRequests = count(),
        PreFilterDistinctUris = dcount(requestUri_s, 0)
        by
            clientIp_s,
            routingRuleName_s
    | where PreFilterRequests >= MinRequests
    | where PreFilterDistinctUris >= MinDistinctUris
    | project
        clientIp_s,
        routingRuleName_s
);
let CandidateRoutingRules =
    CandidateClients
    | summarize by routingRuleName_s;
let HistoricalWindows = materialize(
    AzureDiagnostics
    | where TimeGenerated >= ago(TrainingWindow)
        and TimeGenerated < ago(DetectionWindow)
    | where Category == "FrontDoorAccessLog"
    | where isnotempty(clientIp_s)
        and isnotempty(requestUri_s)
        and isnotempty(routingRuleName_s)
    | where routingRuleName_s in (CandidateRoutingRules)
    | where clientIp_s !in (WhitelistedIps)
    | where routingRuleName_s !in (WhitelistedRoutingRules)
    | where httpStatusCode_d !in (StatusCodeFilters)
    | where not(requestUri_s matches regex StaticResourceRegex)
    | project
        TimeGenerated,
        clientIp_s,
        routingRuleName_s,
        requestUri_s
    | extend UriStructure = requestUri_s
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
        "{uuid}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9A-Fa-f]{16,}",
        "{hex}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"/[A-Za-z0-9_-]{16,}/",
        "/{opaque}/"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9]+",
        "{id}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"([?&][^=&#]+)=([^&#]*)",
        @"\1={value}"
    )
    | summarize hint.strategy=shuffle
        Requests = count(),
        DistinctUris = dcount(requestUri_s, 0),
        DistinctUriStructures = dcount(UriStructure, 0)
        by
            clientIp_s,
            routingRuleName_s,
            TimeBin = bin(TimeGenerated, DetectionWindow)
    | extend
        UriBreadthRatio =
            todouble(DistinctUris) / todouble(Requests),
        UrisPerStructure =
            todouble(DistinctUris)
            / iif(
                DistinctUriStructures < 1,
                1.0,
                todouble(DistinctUriStructures)
            )
);
let IpBaseline =
    HistoricalWindows
    | join kind=leftsemi (
        CandidateClients
        | project clientIp_s, routingRuleName_s
    ) on clientIp_s, routingRuleName_s
    | summarize hint.strategy=shuffle
        MedianDistinctUris = percentile(DistinctUris, 50),
        MedianBreadthRatio = percentile(UriBreadthRatio, 50),
        MedianUrisPerStructure = percentile(UrisPerStructure, 50),
        TrainingWindows = count()
        by
            clientIp_s,
            routingRuleName_s;
let RoutingRuleBaseline =
    HistoricalWindows
    | summarize
        RouteMedianDistinctUris = percentile(DistinctUris, 50),
        RouteMedianBreadthRatio = percentile(UriBreadthRatio, 50),
        RouteMedianUrisPerStructure = percentile(UrisPerStructure, 50)
        by routingRuleName_s;
let CurrentData = materialize(
    CurrentRaw
    | join kind=inner (
        CandidateClients
    ) on clientIp_s, routingRuleName_s
    | project-away clientIp_s1, routingRuleName_s1
    | extend
        clientCountry = tostring(AdditionalFields["clientCountry"]),
        responseBytes = tolong(AdditionalFields["responseBytes"])
    | project-away AdditionalFields
    | extend UriStructure = requestUri_s
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}",
        "{uuid}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9A-Fa-f]{16,}",
        "{hex}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"/[A-Za-z0-9_-]{16,}/",
        "/{opaque}/"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"[0-9]+",
        "{id}"
    )
    | extend UriStructure = replace_regex(
        UriStructure,
        @"([?&][^=&#]+)=([^&#]*)",
        @"\1={value}"
    )
);
let CurrentStatusCodes =
    CurrentData
    | where isnotempty(httpStatusCode_d)
    | summarize
        StatusCount = count()
        by
            clientIp_s,
            routingRuleName_s,
            httpStatusCode_d
    | extend StatusCodeKey = tostring(toint(httpStatusCode_d))
    | summarize
        StatusCodes = make_bag(
            bag_pack(StatusCodeKey, StatusCount)
        )
        by
            clientIp_s,
            routingRuleName_s;
let CurrentActivity =
    CurrentData
    | summarize hint.strategy=shuffle
        Requests = count(),
        DistinctUris = dcount(requestUri_s),
        DistinctUriStructures = dcount(UriStructure),
        ClientCountries = make_set(clientCountry, 10),
        MinResponseBytes = min(responseBytes),
        MaxResponseBytes = max(responseBytes),
        AvgResponseBytes = avg(responseBytes),
        MedianResponseBytes = percentile(responseBytes, 50),
        DistinctResponseSizes = dcount(responseBytes),
        SampleUris = make_set(requestUri_s, 20),
        SampleUriStructures = make_set(UriStructure, 20),
        FirstSeen = min(TimeGenerated),
        LastSeen = max(TimeGenerated)
        by
            clientIp_s,
            routingRuleName_s
    | extend
        UriBreadthRatio =
            todouble(DistinctUris) / todouble(Requests),
        UrisPerStructure =
            todouble(DistinctUris)
            / iif(
                DistinctUriStructures < 1,
                1.0,
                todouble(DistinctUriStructures)
            ),
        ResponseSizeDiversity =
            todouble(DistinctResponseSizes) / todouble(Requests);
CurrentActivity
| join kind=leftouter CurrentStatusCodes
    on clientIp_s, routingRuleName_s
| join kind=leftouter IpBaseline
    on clientIp_s, routingRuleName_s
| join kind=leftouter RoutingRuleBaseline
    on routingRuleName_s
| extend
    IsNewClient = isempty(MedianDistinctUris),
    ExpectedDistinctUris = coalesce(
        MedianDistinctUris,
        RouteMedianDistinctUris
    ),
    ExpectedBreadthRatio = coalesce(
        MedianBreadthRatio,
        RouteMedianBreadthRatio
    ),
    ExpectedUrisPerStructure = coalesce(
        MedianUrisPerStructure,
        RouteMedianUrisPerStructure
    ),
    BaselineType = iff(
        isempty(MedianDistinctUris),
        "RoutingRulePeer",
        "ClientHistorical"
    )
| extend
    DistinctUriDeviation =
        todouble(DistinctUris)
        / iif(
            ExpectedDistinctUris < 1,
            1.0,
            todouble(ExpectedDistinctUris)
        ),
    BreadthDeviation =
        UriBreadthRatio
        / iif(
            ExpectedBreadthRatio <= 0,
            0.01,
            ExpectedBreadthRatio
        ),
    StructureDeviation =
        UrisPerStructure
        / iif(
            ExpectedUrisPerStructure <= 0,
            1.0,
            ExpectedUrisPerStructure
        )
| where DistinctUriDeviation >= MinDistinctUriDeviation
| where BreadthDeviation >= MinBreadthDeviation
| where StructureDeviation >= MinStructureDeviation
| project
    clientIp_s,
    ClientCountries,
    routingRuleName_s,
    BaselineType,
    IsNewClient,
    Requests,
    DistinctUris,
    DistinctUriStructures,
    UrisPerStructure,
    ExpectedUrisPerStructure,
    StructureDeviation,
    StatusCodes,
    MinResponseBytes,
    MaxResponseBytes,
    AvgResponseBytes,
    MedianResponseBytes,
    DistinctResponseSizes,
    ResponseSizeDiversity,
    UriBreadthRatio,
    ExpectedDistinctUris,
    DistinctUriDeviation,
    ExpectedBreadthRatio,
    BreadthDeviation,
    MedianDistinctUris,
    MedianUrisPerStructure,
    RouteMedianDistinctUris,
    RouteMedianUrisPerStructure,
    TrainingWindows,
    FirstSeen,
    LastSeen,
    SampleUris,
    SampleUriStructures
| order by StructureDeviation desc, DistinctUriDeviation desc